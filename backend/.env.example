# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=bloodconnect
DB_PORT=3306

# JWT Configuration (Secret must be at least 32 characters in production)
JWT_SECRET=replace_this_with_a_secure_random_64_character_hex_secret_key_in_production
JWT_EXPIRES_IN=7d

# File Upload Directory
UPLOAD_DIR=uploads

# Allowed Frontend Origins (Comma-separated for CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5500
